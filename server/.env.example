# =============================================================================
# taju.platform — server environment variables
# =============================================================================
# Copia este archivo como .env (desarrollo) o .env.production (producción) y
# rellena cada valor. Ningún secreto real va en este archivo.
#
# Convención de valores de ejemplo:
#   your-*       → reemplazar con el valor real
#   true/false   → booleano literal
#   número       → puerto o entero de configuración
# =============================================================================


# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------

NODE_ENV=development                    # development | production | test
PORT=3001                               # puerto en que escucha Express


# -----------------------------------------------------------------------------
# BASE DE DATOS — MongoDB Atlas
# -----------------------------------------------------------------------------
# URI completa incluye usuario, contraseña, host del cluster y nombre de la db.
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
#
# Clusters:
#   taju-dev  → apunta al cluster de desarrollo
#   taju-prod → apunta al cluster de producción
# El cluster correcto se selecciona cambiando este único valor.

MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/taju


# -----------------------------------------------------------------------------
# AUTENTICACIÓN — JWT
# -----------------------------------------------------------------------------
# Secreto para firmar y verificar tokens. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d                       # duración del token (ej. 1h, 7d, 30d)


# -----------------------------------------------------------------------------
# ALMACENAMIENTO — Cloudinary
# -----------------------------------------------------------------------------
# Credenciales de la cuenta. Obtener desde: cloudinary.com > Settings > API Keys
# Con cld CLI autenticado: cld config para ver los valores activos.

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# -----------------------------------------------------------------------------
# CLIENTE — CORS
# -----------------------------------------------------------------------------
# Origen permitido para solicitudes del cliente. En desarrollo apunta a Vite.

CLIENT_URL=http://localhost:5173
