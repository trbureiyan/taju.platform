    "multer": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/autocannon": "7.12.7",
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "autocannon": "8.0.0",
    "eslint": "10.11.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.8",
